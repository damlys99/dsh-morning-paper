{
  "name": "dsh-morning-paper",
  "version": "0.1.0",
  "description": "The front page for a session you left running: what happened, what broke, and what is waiting on you — computed from the durable event log, never generated by a model.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./briefing": "./lib/briefing.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "screenshots.json",
    "cordis.patch.yml",
    "selftest.mjs",
    "verify-real-log.mjs",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node selftest.mjs",
    "verify:logs": "node verify-real-log.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "briefing",
    "recap",
    "session",
    "while-you-were-out",
    "observability"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.2-alpha.1 <0.2.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.2-alpha.1 <0.2.0-0",
    "@deepseek-ai/dsh-session-query": ">=0.1.2-alpha.1 <0.2.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-query": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/damlys99/dsh-morning-paper.git"
  },
  "homepage": "https://github.com/damlys99/dsh-morning-paper#readme",
  "bugs": {
    "url": "https://github.com/damlys99/dsh-morning-paper/issues"
  }
}
